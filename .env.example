# OpenAI API key
OPENAI_API_KEY=<your_openai_api_key_here>

# Postgres connection string (pgvector/pgvector:pg16 image or compatible)
DATABASE_URL=postgresql://cinepal:cinepal@localhost:5432/cinepal

# Logging level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Kaggle credentials (for catalogue ingestion — alternative to ~/.kaggle/kaggle.json)
# You can find these in your Kaggle account settings under "API". 
# If you prefer, you can also set up a `kaggle.json` file in the `~/.kaggle/` directory with the same information.
KAGGLE_USERNAME=<your_kaggle_username>
KAGGLE_KEY=<your_kaggle_api_key>
