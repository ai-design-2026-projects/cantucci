# LLM API keys — set the one matching `provider` in configs/default.yaml
OPENAI_API_KEY=<your_openai_api_key_here>
OPENROUTER_API_KEY=<your_openrouter_api_key_here>

# Postgres connection string (pgvector/pgvector:pg16 image or compatible)
DATABASE_URL=postgresql://cinepal:cinepal@localhost:4321/cinepal

# Logging level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Kaggle credentials (for catalogue ingestion — alternative to ~/.kaggle/kaggle.json)
# You can find these in your Kaggle account settings under "API".
# If you prefer, you can also set up a `kaggle.json` file in the `~/.kaggle/` directory with the same information.
KAGGLE_USERNAME=<your_kaggle_username>
KAGGLE_KEY=<your_kaggle_api_key>

# Hugging Face — pre-built parquet artifacts (used by `python -m db.ingestion.fetch`)
# HF_TOKEN is only required for private repos; omit it if the dataset repo is public.
CINEPAL_ARTIFACTS_REPO=446f6e6e79/CinePal-embeddings
HF_TOKEN=<your_hf_token>
